# Скопируйте в .env.prod и заполните (на сервере: cp .env.prod.example .env.prod)
APP_NAME=BabyBloom
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://babybloom.am
APP_DOMAIN=babybloom.am
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_PORT=3306
DB_DATABASE=babybloom
DB_USERNAME=babybloom
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=public
BCRYPT_ROUNDS=12
VITE_APP_NAME=BabyBloom
